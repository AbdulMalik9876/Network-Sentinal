{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/netwatch run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/netwatch/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "regions": ["sin1"]
}
